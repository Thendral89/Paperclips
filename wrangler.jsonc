{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pcs--prod",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paperclip-crm",
      "database_id": "77c26211-5130-48cf-b100-c5b2ce957fd9"
    }
  ],
  "triggers": {
    // runs every hour — flags leads untouched for 48h+ (blueprint §4)
    "crons": ["0 * * * *"]
  },
  "vars": {
    // Comma-separated emails allowed to sign in to /admin via Google Sign-In.
    // Checked directly by src/routes/authRoutes.js on every login — this IS
    // the access list, not just a label. Edit to match your team.
    //
    // WARNING: this whole `vars` block gets REPLACED WHOLESALE on every
    // `wrangler deploy` — unlike `secrets` (see below), which persist across
    // deploys independently of this file. If you ever change STAFF_EMAILS
    // by hand in the Cloudflare dashboard instead of here, the next deploy
    // will silently overwrite it back to whatever is committed. Keep this
    // file's value in sync with what should actually be live.
    "STAFF_EMAILS": "teampaperclipstudios@gmail.com,REPLACE_WITH_SECOND_ADMIN_EMAIL@gmail.com"
  }
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, and SESSION_SECRET are all real
  // secrets — never put them in `vars` above. `vars` is fully overwritten on
  // every deploy (that's exactly what silently reset GOOGLE_CLIENT_ID to a
  // placeholder once and broke Google Sign-In in production); `secrets` are
  // not, so they're the only safe home for anything that must survive a
  // redeploy. All three are pushed by the GitHub Actions workflow via
  // `wrangler secret put`, sourced from GitHub repo secrets. See README.
}
